# Copy to .env and replace values before running.
SECRET_KEY=
FLASK_ENV=development
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000
DATABASE_URL=
SEED_DEMO_DATA=true
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_FULL_NAME=
INITIAL_ADMIN_PASSWORD=
INITIAL_INSPECTOR_USERNAME=
INITIAL_INSPECTOR_EMAIL=
INITIAL_INSPECTOR_FULL_NAME=
INITIAL_INSPECTOR_PASSWORD=
INITIAL_STAFF_USERNAME=
INITIAL_STAFF_EMAIL=
INITIAL_STAFF_FULL_NAME=
INITIAL_STAFF_PASSWORD=

# Ollama OpenAI-compatible Chat Completions endpoint.
LLM_API_KEY=
LLM_MODEL=llama3.2
LLM_API_BASE_URL=http://localhost:11434/v1/chat/completions
LLM_TIMEOUT_SECONDS=30
LLM_MAX_PROMPT_CHARS=12000

# Set true only when serving over HTTPS.
SESSION_COOKIE_SECURE=false
