# Copy to .env and replace values before running.
SECRET_KEY=
FLASK_ENV=development
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000
DATABASE_URL=
SEED_DEMO_DATA=false
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_FULL_NAME=
INITIAL_ADMIN_PASSWORD=

# Optional OpenAI-compatible Chat Completions service.
LLM_API_KEY=
LLM_MODEL=gpt-3.5-turbo
LLM_API_BASE_URL=https://api.openai.com/v1/chat/completions
LLM_TIMEOUT_SECONDS=30
LLM_MAX_PROMPT_CHARS=12000

# Set true only when serving over HTTPS.
SESSION_COOKIE_SECURE=false
